{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/target",
      "!!**/coverage",
      "!!**/pkg",
      "!!**/generated",
      "!!.workstream",
      "!!.claude",
      "!!.codex",
      "!!.gemini",
      "!.mcp.json",
      "!opencode.json",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!**/package.json"
    ]
  }
}
