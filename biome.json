{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "error" },
			"correctness": { "noUnusedImports": "error" }
		}
	},
	"formatter": { "indentStyle": "tab", "indentWidth": 2 },
	"javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } },
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!**/target",
			"!!**/coverage",
			"!!**/pkg",
			"!!**/generated",
			"!!.workstream",
			"!!.claude",
			"!!.codex",
			"!!.gemini",
			"!.mcp.json",
			"!opencode.json",
			"!**/*.md",
			"!**/*.yaml",
			"!**/*.yml",
			"!**/package.json"
		]
	}
}
