{
	"extends": "@c9up/ream/tsconfig.app.json",
	"compilerOptions": {
		"rootDir": "./",
		"paths": {
			"#app/*": ["./app/*"],
			"#modules/*": ["./app/modules/*"],
			"#config/*": ["./config/*"],
			"#providers/*": ["./providers/*"],
			"#start/*": ["./start/*"]
		}
