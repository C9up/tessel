{
  "name": "@tessel/server",
  "version": "0.1.0",
  "private": true,
  "description": "Tessel server: blind postman (comet API, relay real time) and web shell.",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#modules/*": "./app/modules/*",
    "#config/*": "./config/*",
    "#providers/*": "./providers/*",
    "#start/*": "./start/*"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/*/http/*.ts"
    ]
  },
  "scripts": {
    "dev": "ream dev",
    "build": "ream build",
    "start": "ream start",
    "migrate": "../../scripts/migrate.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "NODE_ENV=test ream test --threads=1"
  },
  "dependencies": {
    "@c9up/atlas": "^0.3.24",
    "@c9up/blackhole": "^0.1.28",
    "@c9up/chronos": "^0.1.17",
    "@c9up/quasar": "^0.2.4",
    "@c9up/ream": "^0.2.31",
    "@c9up/relay": "^0.1.27",
    "@c9up/rune": "^0.2.4",
    "@c9up/spectrum": "^0.1.19",
    "@c9up/warden": "^0.2.7",
    "@tessel/core-web": "workspace:*",
    "@tessel/protocol": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@c9up/helix": "^0.2.15",
    "@c9up/helix-plugin-ream": "^0.1.10",
    "@c9up/ream-cli": "^0.3.20",
    "@swc-node/register": "^1.12.1",
    "@tessel/messenger": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
