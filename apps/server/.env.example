APP_NAME=tessel
# `ream generate:key` écrit une clé neuve dans .env.
APP_KEY=
NODE_ENV=development
PORT=3460

# PostgreSQL à travers BlackGate seulement, en TLS mutuel.
# `scripts/stack.sh start` écrit ces lignes (mots de passe neufs à chaque démarrage).
DB_HOST=localhost
DB_PORT=5460
DB_DATABASE=tessel
DB_USER=app
DB_PASSWORD=
# Le propriétaire du schéma, pour scripts/migrate.sh seulement : l'app ne tourne jamais sous lui.
DB_OWNER_USER=tessel_owner
DB_OWNER_PASSWORD=
# Tests seulement : PostgreSQL en direct, autour de BlackGate.
DB_DIRECT_PORT=5461
DB_SSL_ROOT_CERT=
DB_SSL_CERT=
DB_SSL_KEY=

REDIS_URL=redis://localhost:6460
