APP_NAME=tessel
# `ream generate:key` writes a fresh key into .env.
APP_KEY=
NODE_ENV=development
PORT=3460

# PostgreSQL over mutual TLS only.
# `scripts/stack.sh start` writes these lines (fresh passwords on every start).
DB_HOST=localhost
DB_PORT=5460
DB_DATABASE=tessel
DB_USER=app
DB_PASSWORD=
# The schema owner, for scripts/migrate.sh only: the app never runs as this role.
DB_OWNER_USER=tessel_owner
DB_OWNER_PASSWORD=
DB_SSL_ROOT_CERT=
DB_SSL_CERT=
DB_SSL_KEY=

REDIS_URL=redis://localhost:6460
