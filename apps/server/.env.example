APP_NAME=tessel
# `ream generate:key` écrit une clé neuve dans .env.
APP_KEY=
NODE_ENV=development
PORT=3460

# Postgres, servi à travers BlackGate : l'app ne connaît que cette adresse.
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5460
DB_DATABASE=tessel
DB_USER=tessel
DB_PASSWORD=

REDIS_URL=redis://localhost:6460
